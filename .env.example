# BotMAX environment (all optional — sensible defaults below)
#
# Your MAX bot token (from https://business.max.ru/self → Чат-боты → Настройки,
# or the "MAX для бизнеса" bot). Required.
# BOTMAX_BOT_TOKEN=your_max_bot_token

# Bind address/port of the Telegram-Bot-API compatibility server (loopback only by default)
BOTMAX_HOST=127.0.0.1
BOTMAX_PORT=18790

# MAX API upstream (default: official)
# BOTMAX_UPSTREAM=https://platform-api2.max.ru

# Where the MAX long-poll marker is persisted
# BOTMAX_STATE=~/.config/botmax/state.json

# Node answer: TLS roots are added via NODE_EXTRA_CA_CERTS (see install.sh).
# The bundled certs/russian-trusted-root-ca.pem (Mintsifry root CA) is required
# to talk to platform-api2.max.ru over TLS.